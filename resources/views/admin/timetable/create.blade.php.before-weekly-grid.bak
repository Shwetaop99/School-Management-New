<div class="tt-modal-backdrop" id="addSubjectModal" aria-hidden="true">
    <div class="tt-modal" role="dialog" aria-modal="true" aria-labelledby="addSubjectTitle">
        <h3 id="addSubjectTitle">Add subject to this period</h3>
        <p>This adds the subject as an option in the current form. To save it permanently in your subject master, use your school’s subject management page.</p>
        <div class="tt-field">
            <label class="tt-label" for="newSubjectName">Subject name</label>
            <input class="tt-control" type="text" id="newSubjectName" maxlength="100" placeholder="e.g. Mathematics">
        </div>
        <div class="tt-modal-actions">
            <button type="button" class="tt-btn" id="cancelAddSubject">Cancel</button>
            <button type="button" class="tt-btn tt-btn-primary" id="confirmAddSubject">Add to timetable</button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const classSelect = document.getElementById('class');
    const sectionSelect = document.getElementById('section');
    const sectionHelp = document.getElementById('sectionHelp');
    const weekStart = document.getElementById('week_start_date');
    const weekDateHelp = document.getElementById('weekDateHelp');
    const form = document.getElementById('weeklyTimetableForm');
    const saveButton = document.getElementById('saveWeeklyBtn');
    const allClasses = @json($classes);
    const allSections = @json($sections);
    const oldSection = @json(old('section'));
    let activeSubjectSelect = null;

    function loadSections(className, selectedSection = '') {
        sectionSelect.innerHTML = '<option value="">Select Section</option>';
        if (!className) {
            sectionHelp.textContent = 'Choose a class to load sections.';
            return;
        }
        const selectedClass = allClasses.find(item =>
            String(item.class_name ?? item.name ?? '').trim() === String(className).trim()
        );
        if (!selectedClass) {
            sectionHelp.textContent = 'No matching class record found.';
            return;
        }
        const sections = allSections.filter(item => String(item.class_id) === String(selectedClass.id));
        sections.forEach(item => {
            const option = document.createElement('option');
            option.value = item.section_name;
            option.textContent = item.section_name;
            option.selected = String(item.section_name) === String(selectedSection);
            sectionSelect.appendChild(option);
        });
        sectionHelp.textContent = sections.length ? 'Choose the section for this class.' : 'No sections found for this class.';
    }

    function formatDate(date) {
        return new Intl.DateTimeFormat('en-IN', {day:'2-digit', month:'short', year:'numeric'}).format(date);
    }

    function updateWeekDates() {
        if (!weekStart.value) return;
        const start = new Date(weekStart.value + 'T12:00:00');
        const monday = start.getDay() === 1;
        weekDateHelp.textContent = monday
            ? 'Monday to Saturday: ' + formatDate(start) + ' – ' + formatDate(new Date(start.getTime() + 5 * 86400000))
            : 'Please choose a Monday.';
        weekDateHelp.style.color = monday ? '#64748b' : '#dc2626';
        document.querySelectorAll('.day-date').forEach(el => {
            el.textContent = formatDate(new Date(start.getTime() + Number(el.dataset.dayIndex) * 86400000));
        });
    }

    function getSubjectLabel(select) {
        const option = select.options[select.selectedIndex];
        return option ? (option.dataset.subjectName || option.textContent.trim()) : '';
    }

    function filterTeachers(cell) {
        const subjectSelect = cell.querySelector('.period-subject');
        const teacherSelect = cell.querySelector('.period-teacher');
        const selectedSubject = getSubjectLabel(subjectSelect).trim().toLowerCase();
        const currentTeacher = teacherSelect.value;

        Array.from(teacherSelect.options).forEach((option, index) => {
            if (index === 0) return;
            const mapping = (option.dataset.subjects || '').split('|').map(s => s.trim().toLowerCase()).filter(Boolean);
            // Only filter when teacher subject mappings exist. Otherwise keep available teachers.
            const shouldFilter = selectedSubject && mapping.length > 0;
            option.hidden = shouldFilter && !mapping.includes(selectedSubject);
            option.disabled = option.hidden;
        });

        if (currentTeacher) {
            const selected = teacherSelect.options[teacherSelect.selectedIndex];
            if (selected && selected.disabled) teacherSelect.value = '';
        }
    }

    function calculateEndTime(cell) {
        const type = cell.querySelector('.period-type').value;
        const start = cell.querySelector('.period-start');
        const end = cell.querySelector('.period-end');
        if (!start.value) return;

        const minutes = type === 'Break' ? 15 : type === 'Lunch' ? 30 : 30;
        const parts = start.value.split(':').map(Number);
        const total = parts[0] * 60 + parts[1] + minutes;
        if (total >= 1440) {
            end.value = '';
            return;
        }
        end.value = String(Math.floor(total / 60)).padStart(2, '0') + ':' + String(total % 60).padStart(2, '0');
    }

    function configureCell(cell) {
        const type = cell.querySelector('.period-type');
        const subject = cell.querySelector('.period-subject');
        const teacher = cell.querySelector('.period-teacher');
        const start = cell.querySelector('.period-start');
        const end = cell.querySelector('.period-end');
        const room = cell.querySelector('.period-room');
        const special = ['Break', 'Lunch'].includes(type.value);

        cell.classList.toggle('tt-special', special);
        subject.required = !special;
        teacher.required = !special;
        [subject, teacher, room].forEach(field => field.disabled = special);

        if (special) {
            subject.value = '';
            teacher.value = '';
            room.value = '';
            end.required = true;
        } else {
            filterTeachers(cell);
            if (start.value && !end.value) calculateEndTime(cell);
        }
    }

    document.querySelectorAll('.tt-cell').forEach(cell => {
        const type = cell.querySelector('.period-type');
        const subject = cell.querySelector('.period-subject');
        const start = cell.querySelector('.period-start');
        const end = cell.querySelector('.period-end');

        type.addEventListener('change', () => {
            configureCell(cell);
            if (start.value) calculateEndTime(cell);
        });
        subject.addEventListener('change', () => {
            if (subject.value === '__add_subject__') {
                subject.value = '';
                activeSubjectSelect = subject;
                document.getElementById('addSubjectModal').classList.add('open');
                document.getElementById('newSubjectName').value = '';
                document.getElementById('newSubjectName').focus();
                return;
            }
            filterTeachers(cell);
        });
        cell.querySelector('.tt-add-subject').addEventListener('click', () => {
            activeSubjectSelect = subject;
            document.getElementById('addSubjectModal').classList.add('open');
            document.getElementById('newSubjectName').value = '';
            document.getElementById('newSubjectName').focus();
        });
        start.addEventListener('change', () => calculateEndTime(cell));
        end.addEventListener('change', () => {
            if (start.value && end.value && end.value <= start.value) {
                end.setCustomValidity('End time must be after start time.');
            } else {
                end.setCustomValidity('');
            }
        });
        configureCell(cell);
    });

    const modal = document.getElementById('addSubjectModal');
    function closeSubjectModal() {
        modal.classList.remove('open');
        activeSubjectSelect = null;
    }
    document.getElementById('cancelAddSubject').addEventListener('click', closeSubjectModal);
    modal.addEventListener('click', event => { if (event.target === modal) closeSubjectModal(); });
    document.getElementById('confirmAddSubject').addEventListener('click', function () {
        const name = document.getElementById('newSubjectName').value.trim();
        if (!name || !activeSubjectSelect) {
            alert('Enter a subject name.');
            return;
        }
        const normalized = name.toLowerCase();
        let option = Array.from(document.querySelectorAll('.period-subject option')).find(opt =>
            opt.value !== '__add_subject__' && (opt.dataset.subjectName || opt.textContent).trim().toLowerCase() === normalized
        );
        if (!option) {
            // Add the same subject to every period dropdown on this page.
            document.querySelectorAll('.period-subject').forEach(select => {
                const addOption = select.querySelector('option[value="__add_subject__"]');
                const newOption = document.createElement('option');
                newOption.value = name;
                newOption.textContent = name;
                newOption.dataset.subjectName = name;
                select.insertBefore(newOption, addOption);
            });
        }
        const targetOption = Array.from(activeSubjectSelect.options).find(opt =>
            opt.value !== '__add_subject__' && (opt.dataset.subjectName || opt.textContent).trim().toLowerCase() === normalized
        );
        if (targetOption) activeSubjectSelect.value = targetOption.value;
        const cell = activeSubjectSelect.closest('.tt-cell');
        if (cell) filterTeachers(cell);
        closeSubjectModal();
    });

    document.getElementById('newSubjectName').addEventListener('keydown', event => {
        if (event.key === 'Enter') {
            event.preventDefault();
            document.getElementById('confirmAddSubject').click();
        }
        if (event.key === 'Escape') closeSubjectModal();
    });

    classSelect.addEventListener('change', () => loadSections(classSelect.value));
    weekStart.addEventListener('change', updateWeekDates);

    form.addEventListener('submit', function (event) {
        if (!weekStart.value || new Date(weekStart.value + 'T12:00:00').getDay() !== 1) {
            event.preventDefault();
            alert('Please choose a Monday for the week starting date.');
            weekStart.focus();
            return;
        }

        let invalid = null;
        document.querySelectorAll('.tt-cell').forEach(cell => {
            if (invalid) return;
            const type = cell.querySelector('.period-type').value;
            const subject = cell.querySelector('.period-subject');
            const teacher = cell.querySelector('.period-teacher');
            const start = cell.querySelector('.period-start');
            const end = cell.querySelector('.period-end');

            if (!start.value) invalid = start;
            else if (!end.value || end.value <= start.value) invalid = end;
            else if (!['Break','Lunch'].includes(type) && !subject.value.trim()) invalid = subject;
            else if (!['Break','Lunch'].includes(type) && !teacher.value) invalid = teacher;
        });

        if (invalid) {
            event.preventDefault();
            alert('Complete each period: subject, teacher, start time and end time. End time must be after start time.');
            invalid.focus();
            return;
        }
        saveButton.disabled = true;
        saveButton.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving timetable...';
    });

    if (classSelect.value) loadSections(classSelect.value, oldSection);
    updateWeekDates();
});
</script>
@endsection
